#!/bin/bash
# doctor — intermittent system maintenance checks per ArchWiki:System_maintenance.
# Read-only: prints findings + the fix command, never runs fixes itself.
# Extra deps: ~/scripts/setup_doctoring.sh (fwupd, archlinux-contrib, atuin pacman hook).
# ponytail: skips full-fs broken-symlink scan (slow) and mirror ranking (rarely stale).
# No set -e: a clean system makes most checks "fail" (grep/pacman -Qtdq exit 1).
set -uo pipefail

# lib adapter: repo-relative (dev/symlink install) → user → system → pacman
script_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for lib in "$script_dir/../lib/common.sh" \
	"${XDG_DATA_HOME:-$HOME/.local/share}/jcz-scripts/common.sh" \
	/usr/local/share/jcz-scripts/common.sh \
	/usr/share/jcz-scripts/common.sh; do
	[[ -f $lib ]] && source "$lib" && break
done
type die >/dev/null 2>&1 || { echo "ERROR: jcz-scripts common.sh not found" >&2; exit 1; }

require checkupdates pacdiff curl # checkupdates/pacdiff: pacman-contrib

W=$'\e[1;33m' R=$'\e[0m'
sec() { printf '\n\e[1;36m── %s\e[0m\n' "$1"; }
say() { printf '%s\n' "${1:-$2}"; } # finding, or fallback when clean

sec "failed units (system + user)"
say "$(systemctl --failed --no-legend 2>/dev/null
	systemctl --user --failed --no-legend 2>/dev/null)" ok

sec "journal errors this boot (journalctl -p3 -b)"
out=$(journalctl -p3 -b -q --no-pager 2>/dev/null)
if [[ -n $out ]]; then
	printf '%s entries, last 3:\n' "$(wc -l <<<"$out")"
	tail -3 <<<"$out"
else
	echo ok
fi

sec "pending updates (checkupdates — safe, no -Sy)"
say "$(checkupdates 2>/dev/null)" none

sec "arch news (read before -Syu)"
curl -sm5 https://archlinux.org/feeds/news/ | grep -oP '(?<=<title>)[^<]+' |
	sed '1d;4q' | sed 's/&gt;/>/g;s/&lt;/</g;s/&amp;/\&/g'

sec ".pacnew / .pacsave (fix: sudo pacdiff)"
say "$(pacdiff --output 2>/dev/null)" none

sec "orphans (fix: pacman -Qtdq | sudo pacman -Rns -)"
say "$(pacman -Qtdq 2>/dev/null)" none

# The atuin lesson: upgraded package, daemon kept running the deleted binary.
# Only own processes are readable; root scope needs sudo checkservices.
sec "processes on deleted binaries (restart them; system scope: sudo checkservices)"
out=""
for e in /proc/[0-9]*/exe; do
	tgt=$(readlink "$e" 2>/dev/null) || continue
	if [[ $tgt == *' (deleted)' ]]; then
		pid=${e%/exe} pid=${pid#/proc/}
		out+="$(ps -o pid=,comm= -p "$pid" 2>/dev/null)"$'\n'
	fi
done
say "${out%$'\n'}" none

sec "kernel"
run=$(uname -r) inst=$(pacman -Q linux | awk '{print $2}')
if [[ ${run//-/.} == "${inst//-/.}" ]]; then
	echo "running $run = installed, ok"
else
	echo "${W}running $run != installed $inst — reboot${R}"
fi

sec "firmware (fwupd)"
if command -v fwupdmgr >/dev/null; then
	if timeout 10 fwupdmgr get-updates &>/dev/null; then
		echo "${W}updates available — fwupdmgr update${R}"
	else
		echo ok
	fi
else
	echo "fwupd not installed — run ~/scripts/setup_doctoring.sh"
fi

sec "disk / cache / foreign"
df -h --output=target,size,used,avail,pcent / /home | sed 1d
echo "pacman cache: $(du -sh /var/cache/pacman/pkg 2>/dev/null | cut -f1) (trim: sudo paccache -rk2 && sudo paccache -ruk0)"
echo "foreign pkgs (AUR/manual, review per wiki): $(pacman -Qm | wc -l)"

sec "/home snapshots"
newest=$(ls -1dt /.snapshots/home-* 2>/dev/null | head -1)
say "${newest:+newest: $newest}" \
	"${W}none — snapshot infra not provisioned (snaps/snap-now aliases are dead)${R}"
